{# Embeddable regional forecast.

   A fragment, not a page: no doctype, no <body>, and every selector scoped
   under .sw-forecast so it cannot collide with the host site's CSS or be
   overridden by it. Typography is inherited from the host so it matches the
   surrounding page; only layout and colour are ours. #}
<div class="sw-forecast" data-region="{{ summary.name }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Montserrat:wght@400;600;700&display=swap">
<style>
  /* Sheerr Weather brand: the site's sky blue #37c3ff, with Montserrat for
     labels and Lora for reading text. The pure brand blue is only 2.0:1 on
     white, so text uses a darkened variant of the same hue (5.3:1) and the
     bright blue is kept for rules and marks. */
  .sw-forecast {
    --sw-brand:#37c3ff; --sw-accent:#0072a3; --sw-accent-bg:#e0f6ff;
    --sw-ink:#000; --sw-soft:#4d5d6b; --sw-faint:#7a8894;
    --sw-rule:#e4e9ed; --sw-card:#fff;
    --sw-warn-bg:#fdf4e8; --sw-warn-rule:#e8c89a; --sw-warn-ink:#8a5418;
    --sw-calm:#3f8a5f; --sw-breezy:#b5811f; --sw-windy:#c2631f; --sw-severe:#a32f2f;
    --sw-sans:"Montserrat","Helvetica Neue",Helvetica,Arial,sans-serif;
    --sw-serif:"Lora",Georgia,"Times New Roman",serif;
    color:var(--sw-ink) !important; line-height:1.65; max-width:52rem; margin:0 auto;
    box-sizing:border-box; font-family:var(--sw-serif);
  }
  .sw-forecast *, .sw-forecast *::before, .sw-forecast *::after { box-sizing:inherit; }
  /* One palette only. The host page is always light, so there is no dark
     variant and nothing that can turn the text pale. */

  .sw-forecast .sw-head {
    border-bottom:3px solid var(--sw-brand); padding-bottom:.6rem; margin-bottom:1.1rem;
  }
  .sw-forecast .sw-eyebrow {
    font-family:var(--sw-sans); font-size:.66rem; letter-spacing:.16em;
    text-transform:uppercase; color:var(--sw-accent) !important;
    font-weight:700; margin:0 0 .3rem;
  }
  .sw-forecast .sw-title {
    font-family:var(--sw-sans); font-size:1.55rem; font-weight:700; margin:0;
    line-height:1.2; letter-spacing:-.01em; color:var(--sw-ink) !important;
  }
  .sw-forecast .sw-sub {
    font-family:var(--sw-sans); font-size:.8rem; color:var(--sw-soft) !important;
    margin:.3rem 0 0;
  }

  .sw-forecast .sw-alert {
    background:var(--sw-warn-bg); border:1px solid var(--sw-warn-rule);
    border-left:4px solid var(--sw-warn-ink); border-radius:3px;
    padding:.9rem 1.1rem; margin:0 0 1.2rem;
  }
  .sw-forecast .sw-alert { padding:.75rem 1rem; }
  .sw-forecast .sw-alert > summary {
    cursor:pointer; list-style:none; display:block; color:var(--sw-warn-ink) !important;
  }
  .sw-forecast .sw-alert > summary::-webkit-details-marker { display:none; }
  .sw-forecast .sw-places {
    list-style:none; margin:.5rem 0 0; padding:0;
    display:flex; flex-wrap:wrap; gap:.3rem .4rem;
  }
  .sw-forecast .sw-places li {
    font-family:var(--sw-sans); font-size:.74rem; line-height:1.3;
    color:var(--sw-warn-ink) !important; background:rgba(0,0,0,.04);
    border:1px solid var(--sw-warn-rule); border-radius:2px;
    padding:.18rem .45rem; margin:0;
  }
  .sw-forecast .sw-alert > summary::after {
    content:"Read the full statement ▸"; display:block; margin-top:.4rem;
    font-family:var(--sw-sans); font-size:.68rem; letter-spacing:.08em;
    text-transform:uppercase; opacity:.85;
  }
  .sw-forecast .sw-alert[open] > summary::after { content:"Hide the full statement ▾"; }
  .sw-forecast .sw-alert-name {
    display:block; font-family:var(--sw-sans); font-size:.86rem; font-weight:700;
    letter-spacing:.02em; color:var(--sw-warn-ink) !important;
  }
  .sw-forecast .sw-alert-lead {
    display:block; font-family:var(--sw-serif); font-size:.88rem;
    color:var(--sw-soft) !important; margin-top:.2rem;
  }
  .sw-forecast .sw-alert p { margin:.3rem 0; font-size:.86rem; color:var(--sw-soft); white-space:pre-line; }

  .sw-forecast .sw-day { border-top:1px solid var(--sw-rule); padding:1.1rem 0 .3rem; }
  .sw-forecast .sw-day:first-of-type { border-top:0; padding-top:0; }
  .sw-forecast .sw-day h3 {
    font-family:var(--sw-sans); font-size:.7rem; letter-spacing:.14em;
    text-transform:uppercase; color:var(--sw-accent) !important;
    margin:0 0 .5rem; font-weight:700;
  }
  .sw-forecast .sw-text {
    font-family:var(--sw-serif); font-size:1.06rem; line-height:1.7;
    margin:0 0 .95rem; color:var(--sw-ink) !important;
  }

  .sw-forecast .sw-figs {
    display:grid; gap:1px; background:var(--sw-rule);
    border:1px solid var(--sw-rule); border-radius:4px; overflow:hidden;
    grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr));
  }
  .sw-forecast .sw-fig { background:var(--sw-card); padding:.7rem .85rem; }
  .sw-forecast .sw-k {
    font-family:var(--sw-sans); font-size:.62rem; letter-spacing:.12em;
    text-transform:uppercase; color:var(--sw-faint) !important; font-weight:700;
    display:block; margin-bottom:.25rem;
  }
  .sw-forecast .sw-v {
    font-family:var(--sw-sans); font-size:1.18rem; font-weight:600;
    font-variant-numeric:tabular-nums; letter-spacing:-.01em;
  }
  .sw-forecast .sw-n {
    font-family:var(--sw-sans); font-size:.72rem; color:var(--sw-soft) !important;
    display:block; margin-top:.2rem;
  }
  .sw-forecast .sw-calm{color:var(--sw-calm) !important} .sw-forecast .sw-breezy{color:var(--sw-breezy) !important}
  .sw-forecast .sw-windy{color:var(--sw-windy) !important} .sw-forecast .sw-severe{color:var(--sw-severe) !important}


  /* Seven-day strip */
  .sw-forecast .sw-week {
    display:grid; gap:1px; background:var(--sw-rule);
    border:1px solid var(--sw-rule); border-radius:4px; overflow:hidden;
    grid-template-columns:repeat(7,1fr); margin-top:.6rem;
  }
  .sw-forecast .sw-wd {
    background:var(--sw-card); padding:.7rem .3rem .8rem; text-align:center;
  }
  .sw-forecast .sw-wd-name {
    font-family:var(--sw-sans); font-size:.62rem; letter-spacing:.1em;
    text-transform:uppercase; color:var(--sw-faint) !important; font-weight:700;
  }
  .sw-forecast .sw-wd-date {
    font-family:var(--sw-sans); font-size:.6rem; color:var(--sw-faint) !important;
    display:block; margin-top:.1rem;
  }
  .sw-forecast .sw-icon { width:32px; height:32px; display:block; margin:.45rem auto .35rem; }
  .sw-forecast .sw-i-sun { fill:#f2a33c; }
  .sw-forecast .sw-i-ray { stroke:#f2a33c; stroke-width:2; stroke-linecap:round; fill:none; }
  .sw-forecast .sw-i-cloud { fill:#b9c6d1; }
  .sw-forecast .sw-i-rain { stroke:var(--sw-brand); stroke-width:2.2; stroke-linecap:round; fill:none; }
  .sw-forecast .sw-i-snow { stroke:#9fd4ef; stroke-width:1.8; stroke-linecap:round; fill:none; }
  .sw-forecast .sw-wd-hi {
    font-family:var(--sw-sans); font-size:1.02rem; font-weight:700;
    font-variant-numeric:tabular-nums;
  }
  .sw-forecast .sw-wd-lo {
    font-family:var(--sw-sans); font-size:.86rem; color:var(--sw-soft) !important;
    font-variant-numeric:tabular-nums;
  }
  .sw-forecast .sw-wd-pop {
    font-family:var(--sw-sans); font-size:.62rem; color:var(--sw-accent) !important;
    display:block; margin-top:.25rem; font-weight:600; min-height:.9rem;
  }
  .sw-forecast .sw-week-title {
    font-family:var(--sw-sans); font-size:.68rem; letter-spacing:.14em;
    text-transform:uppercase; color:var(--sw-accent) !important; font-weight:700;
    margin:1.6rem 0 0;
  }
  @media (max-width:560px) {
    .sw-forecast .sw-week { grid-template-columns:repeat(4,1fr); }
    .sw-forecast .sw-icon { width:28px; height:28px; }
  }
  @media (max-width:360px) { .sw-forecast .sw-week { grid-template-columns:repeat(3,1fr); } }
  .sw-forecast .sw-foot {
    border-top:1px solid var(--sw-rule); margin-top:1.3rem; padding-top:.8rem;
    font-family:var(--sw-sans); font-size:.72rem; color:var(--sw-faint) !important;
  }
  .sw-forecast .sw-foot p { margin:.2rem 0; }
  @media (max-width:420px) { .sw-forecast .sw-title { font-size:1.35rem; } }
</style>


{# Icons are inline SVG: no network request, crisp at any size, and they
   take their colours from the surrounding theme. #}
{% macro wx_icon(kind) %}
<svg class="sw-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {% if kind == "sun" %}
    <circle cx="16" cy="16" r="6.5" class="sw-i-sun"/>
    <g class="sw-i-ray">
      <path d="M16 2.5v3.5M16 26v3.5M29.5 16H26M6 16H2.5M25.5 6.5l-2.5 2.5M9 23l-2.5 2.5M25.5 25.5L23 23M9 9L6.5 6.5"/>
    </g>
  {% elif kind == "sun-cloud" %}
    <circle cx="13" cy="12.5" r="5.5" class="sw-i-sun"/>
    <g class="sw-i-ray"><path d="M13 1.5v3M24.5 12.5h-3M21.2 4.3l-2.1 2.1M4.8 4.3l2.1 2.1M1.5 12.5h3"/></g>
    <path class="sw-i-cloud" d="M12 26h11a4.5 4.5 0 0 0 .6-9 6.2 6.2 0 0 0-11.9 1.3A4 4 0 0 0 12 26z"/>
  {% elif kind == "part-cloud" %}
    <circle cx="11.5" cy="11.5" r="5" class="sw-i-sun"/>
    <g class="sw-i-ray"><path d="M11.5 1v3M20 11.5h-3M18 5l-2 2M5 5l2 2M3 11.5h3"/></g>
    <path class="sw-i-cloud" d="M11 27h12a5 5 0 0 0 .6-10 6.8 6.8 0 0 0-13-1.4A4.4 4.4 0 0 0 11 27z"/>
  {% elif kind == "mostly-cloud" %}
    <circle cx="10" cy="10.5" r="4" class="sw-i-sun"/>
    <path class="sw-i-cloud" d="M10 27h13a5.2 5.2 0 0 0 .6-10.4 7.2 7.2 0 0 0-13.9-1.5A4.6 4.6 0 0 0 10 27z"/>
  {% elif kind == "cloud" %}
    <path class="sw-i-cloud" d="M9.5 25h13.5a5.4 5.4 0 0 0 .6-10.8 7.5 7.5 0 0 0-14.4-1.5A4.8 4.8 0 0 0 9.5 25z"/>
  {% elif kind in ("rain", "showers") %}
    <path class="sw-i-cloud" d="M9.5 20h13.5a5.4 5.4 0 0 0 .6-10.8 7.5 7.5 0 0 0-14.4-1.5A4.8 4.8 0 0 0 9.5 20z"/>
    <g class="sw-i-rain"><path d="M12 23.5l-1.5 4.5M18 23.5l-1.5 4.5M24 23.5l-1.5 4.5"/></g>
  {% elif kind == "snow" %}
    <path class="sw-i-cloud" d="M9.5 20h13.5a5.4 5.4 0 0 0 .6-10.8 7.5 7.5 0 0 0-14.4-1.5A4.8 4.8 0 0 0 9.5 20z"/>
    <g class="sw-i-snow"><path d="M12 24v4M10.3 25l3.4 2M13.7 25l-3.4 2M22 24v4M20.3 25l3.4 2M23.7 25l-3.4 2"/></g>
  {% else %}
    <path class="sw-i-cloud" d="M9.5 20h13.5a5.4 5.4 0 0 0 .6-10.8 7.5 7.5 0 0 0-14.4-1.5A4.8 4.8 0 0 0 9.5 20z"/>
    <g class="sw-i-rain"><path d="M12 23.5l-1.5 4.5M22 23.5l-1.5 4.5"/></g>
    <g class="sw-i-snow"><path d="M17 24v4M15.3 25l3.4 2M18.7 25l-3.4 2"/></g>
  {% endif %}
</svg>
{% endmacro %}

{% macro gust_class(v) %}{% if v is none %}sw-calm{% elif v >= 80 %}sw-severe{% elif v >= 60 %}sw-windy{% elif v >= 40 %}sw-breezy{% else %}sw-calm{% endif %}{% endmacro %}

  <div class="sw-head">
    <p class="sw-eyebrow">Regional Forecast</p>
    <p class="sw-title">{{ summary.name }}</p>
    <p class="sw-sub">Issued {{ summary.generated_at | datestr }} at {{ summary.generated_at | clock }} {{ summary.generated_at.strftime('%Z') }}</p>
  </div>

  {% for a in summary.alerts %}
  <details class="sw-alert">
    <summary>
      <span class="sw-alert-name">{{ a.eventDescription or "Weather alert" }}</span>
      {% set lead = a | alert_lead %}
      {% if lead %}<span class="sw-alert-lead">{{ lead }}</span>{% endif %}
      {% set places = a | alert_locations %}
      {% if places %}
      <ul class="sw-places">
        {% for place in places %}<li>{{ place }}</li>{% endfor %}
      </ul>
      {% endif %}
    </summary>
    {% if a.description %}<p>{{ a.description | trim }}</p>{% else %}<p>{{ a.headlineText }}</p>{% endif %}
  </details>
  {% endfor %}

  {% for entry in narratives %}
  <div class="sw-day">
    <h3>{{ entry.day.label or entry.day.day_of_week }}{% if not entry.day.night_only %}, {{ entry.day.date.strftime('%B %-d') }}{% endif %}</h3>
    <p class="sw-text">{{ entry.narrative.headline }} {{ entry.narrative.discussion }}</p>
    <div class="sw-figs">
      {% if entry.day.night_only and entry.day.low %}
      <div class="sw-fig"><span class="sw-k">Overnight low</span>
        <span class="sw-v">{{ entry.day.low.low.value | num }}{{ units.temp }}</span></div>
      {% elif entry.day.high %}
      <div class="sw-fig"><span class="sw-k">High</span>
        <span class="sw-v">{% if entry.day.high.uniform %}{{ entry.day.high.high.value | num }}{% else %}{{ entry.day.high.low.value | num }}–{{ entry.day.high.high.value | num }}{% endif %}{{ units.temp }}</span>
        {% if not entry.day.high.uniform %}<span class="sw-n">Coolest {{ entry.day.high.low.area }}</span>{% endif %}
      </div>
      {% endif %}
      {% if entry.day.gust %}
      <div class="sw-fig"><span class="sw-k">Gusts</span>
        <span class="sw-v {{ gust_class(entry.day.gust.high.value) | trim }}">{{ entry.day.gust.low.value | num }}–{{ entry.day.gust.high.value | num }}</span>
        <span class="sw-n">{{ units.speed }} · strongest {{ entry.day.gust.high.area }}</span></div>
      {% endif %}
      {% if entry.day.wind_speed %}
      <div class="sw-fig"><span class="sw-k">Wind</span>
        <span class="sw-v">{{ entry.day.wind_speed.low.value | num }}–{{ entry.day.wind_speed.high.value | num }}</span>
        <span class="sw-n">{{ units.speed }}{% if entry.day.dominant_direction %} {{ entry.day.dominant_direction | direction | lower }}{% endif %}</span></div>
      {% endif %}
      {% if entry.day.precip_chance %}
      <div class="sw-fig"><span class="sw-k">Chance of rain</span>
        <span class="sw-v">{{ entry.day.precip_chance.high.value | num }}%</span>
        {% if entry.day.precip_start or entry.day.precip_underway %}
        <span class="sw-n">{% if entry.day.precip_start and not entry.day.precip_underway %}Beginning {{ entry.day.precip_start | clock_words }}{% elif entry.day.precip_end %}Ending {{ entry.day.precip_end | clock_words }}{% else %}Already underway{% endif %}</span>
        {% endif %}</div>
      {% endif %}
    </div>
  </div>
  {% endfor %}

  {% set strip = summary.outlook or summary.days %}
  {% if strip | length > 1 %}
  <p class="sw-week-title">The week ahead</p>
  <div class="sw-week">
    {% for day in strip[:7] %}
    <div class="sw-wd">
      <span class="sw-wd-name">{{ "Today" if loop.first else day.date.strftime('%a') }}</span>
      <span class="sw-wd-date">{{ day.date.strftime('%-d %b') }}</span>
      {{ wx_icon(day.icon) }}
      <span class="sw-wd-hi">{{ day.high.high.value | num if day.high else "—" }}°</span>
      <span class="sw-wd-lo">{{ day.low.low.value | num if day.low else "—" }}°</span>
      <span class="sw-wd-pop">{% if day.precip_chance and day.precip_chance.high.value >= 20 %}{{ day.precip_chance.high.value | num }}%{% endif %}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="sw-foot">
    <p>Sampled across {{ summary.members | length }} points: {{ summary.member_names | join(", ") }}.</p>
    <p>{{ attributions | join(" · ") }}</p>
  </div>
</div>
