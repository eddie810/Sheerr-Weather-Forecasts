{% extends "_layout.html.j2" %}
{% block title %}{{ summary.name }} Forecast{% endblock %}

{% macro gust_class(v) %}{% if v is none %}{% elif v >= 80 %}severe{% elif v >= 60 %}windy{% elif v >= 40 %}breezy{% else %}calm{% endif %}{% endmacro %}

{% block content %}
<div class="sheet">
  <header>
    <div class="eyebrow">Sheerr Weather · Regional Forecast{% if home %} · <a href="{{ home }}" style="color:inherit">All forecasts</a>{% endif %}</div>
    <h1>{{ summary.name }}</h1>
    <div class="when">{{ summary.members | length }} points sampled · {{ summary.member_names | join(", ") }}</div>
  </header>

  {% if summary.alerts %}
  {% for a in summary.alerts %}
  <details class="alert">
    <summary style="cursor:pointer;list-style:none">
      <span style="display:block;font-weight:600;color:var(--warn-ink);font-size:.95rem">{{ a.eventDescription or "Weather alert" }}</span>
      {% set lead = a | alert_lead %}
      {% if lead %}<span style="display:block;font-size:.86rem;color:var(--ink-soft);margin-top:.2rem">{{ lead }}</span>{% endif %}
      {% set places = a | alert_locations %}
      {% if places %}
      <ul style="list-style:none;margin:.5rem 0 0;padding:0;display:flex;flex-wrap:wrap;gap:.3rem .4rem">
        {% for place in places %}<li style="font-size:.74rem;color:var(--warn-ink);border:1px solid var(--warn-rule);border-radius:2px;padding:.15rem .45rem">{{ place }}</li>{% endfor %}
      </ul>
      {% endif %}
      <span style="display:block;font-size:.72rem;color:var(--ink-faint);margin-top:.35rem">Read the full statement</span>
    </summary>
    {% if a.description %}<p>{{ a.description | trim }}</p>{% else %}<p>{{ a.headlineText }}</p>{% endif %}
    <div class="src">{{ a.officeName or "Issuing office" }}</div>
  </details>
  {% endfor %}
  {% endif %}

  {% for entry in narratives %}
  <section>
    <h2 class="sec">{{ entry.day.label or entry.day.day_of_week }}{% if not entry.day.night_only %}, {{ entry.day.date.strftime('%B %-d') }}{% endif %}</h2>
    {# Terse forecast text reads as one continuous statement, not a
       headline over a body. #}
    <p style="margin:0 0 1rem;max-width:64ch;font-size:1.02rem;line-height:1.6">{{ entry.narrative.headline }} {{ entry.narrative.discussion }}</p>
    {% if entry.narrative.source != "claude" %}
    <p style="font-size:.72rem;color:var(--ink-faint);margin:-.6rem 0 1rem">Written by rule{% if "validation" in entry.narrative.source %} — generated text cited an unsupported figure{% endif %}.</p>
    {% endif %}

    <div class="readout">
      {% if entry.day.high and not entry.day.night_only %}
      <div class="cell">
        <div class="k">Highs</div>
        <div class="v">{% if entry.day.high.uniform %}{{ entry.day.high.high.value | num }}{{ units.temp }}{% else %}{{ entry.day.high.low.value | num }}–{{ entry.day.high.high.value | num }}{{ units.temp }}{% endif %}</div>
        {% if not entry.day.high.uniform %}<div class="n">Coolest {{ entry.day.high.low.area }}</div>{% endif %}
      </div>
      {% endif %}
      {% if entry.day.low and entry.day.night_only %}
      <div class="cell">
        <div class="k">Overnight low</div>
        <div class="v">{{ entry.day.low.low.value | num }}–{{ entry.day.low.high.value | num }}{{ units.temp }}</div>
      </div>
      {% endif %}
      {% if entry.day.gust %}
      <div class="cell">
        <div class="k">Peak gusts</div>
        <div class="v {{ gust_class(entry.day.gust.high.value) | trim }}">{{ entry.day.gust.low.value | num }}–{{ entry.day.gust.high.value | num }}</div>
        <div class="n">{{ units.speed }} · strongest {{ entry.day.gust.high.area }}</div>
      </div>
      {% endif %}
      {% if entry.day.wind_speed %}
      <div class="cell">
        <div class="k">Sustained wind</div>
        <div class="v">{{ entry.day.wind_speed.low.value | num }}–{{ entry.day.wind_speed.high.value | num }}</div>
        <div class="n">{{ units.speed }}{% if entry.day.dominant_direction %} from the {{ entry.day.dominant_direction | direction | lower }}{% endif %}</div>
      </div>
      {% endif %}
      {% if entry.day.precip_chance %}
      <div class="cell">
        <div class="k">Chance of rain</div>
        <div class="v">{{ entry.day.precip_chance.high.value | num }}%</div>
        {% if entry.day.precip_start and not entry.day.precip_underway %}<div class="n">Beginning {{ entry.day.precip_start | clock_words }}</div>
        {% elif entry.day.precip_underway and entry.day.precip_end %}<div class="n">Ending {{ entry.day.precip_end | clock_words }}</div>
        {% elif entry.day.precip_underway %}<div class="n">Already underway</div>{% endif %}
      </div>
      {% endif %}
    </div>

    {% if entry.day.peak_window %}
    <p style="font-size:.82rem;color:var(--ink-soft);margin:.7rem 0 0">
      {% if entry.day.peak_window[0] == entry.day.peak_window[1] %}Strongest winds around {{ entry.day.peak_window[0] | clock }}{% else %}Strongest winds between {{ entry.day.peak_window[0] | clock }} and {{ entry.day.peak_window[1] | clock }}{% endif %}{% if entry.day.peak_gust_where %}, peaking at {{ entry.day.peak_gust_where }}{% endif %}.
    </p>
    {% endif %}
  </section>
  {% endfor %}

  <section>
    <h2 class="sec">How this forecast is made</h2>
    <div class="prov">
      {% for src, label in summary.sources.items() %}
      <div><span class="f">{{ src }}</span><span class="s">{{ label }}</span></div>
      {% endfor %}
    </div>
    <p style="font-size:.8rem;color:var(--ink-soft);margin:1rem 0 0;max-width:62ch">
      Figures are aggregated across {{ summary.members | length }} sampled points and quoted as ranges.
      {% if narrative_source == "claude" %}
      The written discussion is generated by Claude from those figures; every number in it is
      checked back against the source data before publication.
      {% elif narrative_source == "mixed" %}
      Written discussions are generated by Claude from those figures, with every number checked
      back against the source data. Any day marked below fell back to generated-by-rule text.
      {% else %}
      The written discussion is generated from the figures by rule.
      {% endif %}
    </p>
    {% if warnings %}
    <p style="font-size:.78rem;color:var(--ink-faint);margin:.6rem 0 0">
      {% for w in warnings %}{{ w }}.<br>{% endfor %}
    </p>
    {% endif %}
  </section>

  <footer>
    <div>Generated {{ summary.generated_at | datestr }} at {{ summary.generated_at | clock }} {{ summary.generated_at.strftime('%Z') }}, {{ summary.name }} local time.</div>
    {% for line in attributions %}<div>{{ line }}</div>{% endfor %}
    {% if summary.missing %}<div>Not sampled this run: {{ summary.missing | join(", ") }}.</div>{% endif %}
  </footer>
</div>
{% endblock %}
