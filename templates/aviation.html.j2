{% extends "_layout.html.j2" %}
{% block title %}{{ airport.iata }} {{ {"arrival":"Arrivals","departure":"Departures"}.get(direction, "Board") }}{% endblock %}

{% block content %}
{# A flight information display board commits to one visual world: dark,
   monospace, amber. Every colour is painted explicitly so the page holds
   on either host ground rather than borrowing the viewer's theme. #}
<style>
  .fids {
    --board:#0a0d11; --panel:#141a21; --rule:#232c36;
    --ink:#e9eef2; --dim:#8899a6; --amber:#ffb000;
    --clear:#3fbf7f; --monitor:#ffc233; --risk:#ff8746;
    background:var(--board); color:var(--ink);
    font-family:"IBM Plex Mono",ui-monospace,monospace;
    min-height:100%; margin:0 auto; max-width:78rem;
    padding-inline:16px; padding-block:1.5rem 3rem;
  }
  .fids a { color:var(--amber); }

  .fids-head {
    display:flex; flex-wrap:wrap; align-items:baseline; gap:.4rem 1.4rem;
    border-bottom:2px solid var(--amber); padding-bottom:.7rem; margin-bottom:.2rem;
  }
  .fids-head h1 {
    font-family:"IBM Plex Mono",monospace; font-size:clamp(1.3rem,4.5vw,2.1rem);
    font-weight:600; letter-spacing:.06em; text-transform:uppercase;
    margin:0; color:var(--amber); text-wrap:balance;
  }
  .fids-head .mode {
    font-size:clamp(1rem,3.5vw,1.5rem); letter-spacing:.22em;
    text-transform:uppercase; color:var(--ink);
  }
  .fids-head .clock { margin-left:auto; font-size:.86rem; color:var(--dim); letter-spacing:.08em; }

  .strip {
    display:flex; flex-wrap:wrap; gap:.4rem 1.6rem; padding:.7rem 0 1.1rem;
    font-size:.76rem; letter-spacing:.1em; text-transform:uppercase; color:var(--dim);
  }
  .strip b { color:var(--ink); font-weight:600; letter-spacing:.06em; }

  .notice {
    border:1px solid var(--amber); border-left-width:4px; background:#1a150a;
    padding:.8rem 1rem; margin-bottom:1.2rem;
  }
  .notice h2 {
    font-size:.74rem; letter-spacing:.16em; text-transform:uppercase;
    color:var(--amber); margin:0 0 .45rem; font-weight:600;
  }
  .notice p { margin:.25rem 0; font-size:.82rem; color:var(--ink); }

  .board-wrap { overflow-x:auto; border:1px solid var(--rule); background:var(--panel); }
  table.board { border-collapse:collapse; width:100%; min-width:44rem; font-size:.86rem;
                color:#e9eef2; }
  table.board th {
    background:#0e131a; color:var(--amber); text-align:left; font-weight:600;
    font-size:.68rem; letter-spacing:.16em; text-transform:uppercase;
    padding:.75rem .85rem; border-bottom:2px solid var(--amber); white-space:nowrap;
  }
  table.board td {
    padding:.72rem .85rem; border-bottom:1px solid var(--rule);
    font-variant-numeric:tabular-nums; vertical-align:top; color:var(--ink);
  }
  table.board tr:nth-child(even) td { background:#11171e; }
  table.board tr:last-child td { border-bottom:none; }
  .flt { font-weight:600; letter-spacing:.08em; font-size:.95rem; color:var(--ink); }
  .port { color:var(--amber); letter-spacing:.04em; }
  .time { font-size:1.05rem; font-weight:600; letter-spacing:.06em; color:var(--ink); }
  .ac { color:var(--dim); }
  .why { color:var(--dim); font-size:.78rem; max-width:26rem; white-space:normal; }

  .chip {
    display:inline-block; padding:.2rem .55rem; font-size:.68rem; font-weight:600;
    letter-spacing:.12em; text-transform:uppercase; border:1px solid currentColor;
    white-space:nowrap;
  }
  .c-green{color:var(--clear)} .c-yellow{color:var(--monitor)} .c-orange{color:var(--risk)}

  .panel { border:1px solid var(--rule); background:var(--panel); margin-top:1.4rem; }
  .panel h2 {
    font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; color:var(--amber);
    margin:0; padding:.7rem .9rem; border-bottom:1px solid var(--rule); font-weight:600;
  }
  .panel pre {
    margin:0; padding:.9rem; font-family:inherit; font-size:.78rem; line-height:1.65;
    color:var(--ink); white-space:pre-wrap; word-break:break-word;
  }
  .legend { display:flex; flex-wrap:wrap; gap:.5rem 1.2rem; padding:.9rem 0 0; font-size:.72rem; color:var(--dim); }
  .fids footer {
    margin-top:1.6rem; padding-top:1rem; border-top:1px solid var(--rule);
    font-size:.72rem; color:var(--dim); line-height:1.7;
  }
  .fids footer strong { color:var(--amber); }
  .toggle { display:inline-flex; border:1px solid var(--rule); }
  .toggle button {
    font:inherit; font-size:.68rem; letter-spacing:.12em; text-transform:uppercase;
    padding:.3rem .7rem; background:transparent; color:var(--dim);
    border:0; cursor:pointer;
  }
  .toggle button.on { background:var(--amber); color:#0a0d11; font-weight:600; }
  .toggle button:focus-visible { outline:2px solid var(--amber); outline-offset:2px; }

  .outlook { color:var(--ink); font-size:.78rem; white-space:nowrap; }
  /* Advanced detail is hidden until asked for, and the runway and crosswind
     columns come with it. */
  .adv-only, .fids.adv .normal-only { display:none; }
  .fids.adv .adv-only { display:inline; }
  .fids:not(.adv) .adv-cell { display:none; }

  /* On a phone a nine-column board cannot be read sideways, so each flight
     becomes a stacked card with its own labels. */
  .fids, .fids * { box-sizing:border-box; }
  @media (max-width:760px) {
    .board-wrap { overflow-x:visible; border:0; background:transparent; }
    table.board, table.board tbody, table.board tr, table.board td { display:block; width:100%; }
    table.board { min-width:0; }
    table.board thead { display:none; }
    table.board tr {
      border:1px solid var(--rule); background:var(--panel);
      margin-bottom:.7rem; padding:.55rem .2rem;
    }
    table.board tr:nth-child(even) td { background:transparent; }
    table.board td {
      border-bottom:0; padding:.28rem .8rem;
      display:flex; gap:1rem; align-items:baseline; justify-content:space-between;
    }
    table.board td::before {
      content:attr(data-l); color:var(--amber); font-size:.62rem;
      letter-spacing:.14em; text-transform:uppercase; flex:0 0 auto;
    }
    table.board td.why, table.board td.outlook { white-space:normal; text-align:right; }
    .why { max-width:none; }
  }
</style>

<div class="fids">
  <div class="fids-head">
    <h1>{{ airport.name }}</h1>
    <span class="mode">{{ {"arrival":"Arrivals","departure":"Departures"}.get(direction, "All Movements") }}</span>
    <span class="clock">{{ generated_at | datestr }} · {{ generated_at | clock }} {{ generated_at.strftime('%Z') }}</span>
  </div>

  <div class="strip">
    <span>{{ airport.icao }}</span>
    <span>Cond <b>{{ metar.fltCat or "—" }}</b></span>
    <span>Wind <b>{{ metar.wdir | num }}°/{{ metar.wspd | num }}kt</b></span>
    <span>Vis <b>{{ metar.visib }}sm</b></span>
    <span>Temp <b>{{ metar.temp | num }}°C</b></span>
    {% if home %}<span><a href="{{ home }}">All forecasts</a></span>{% endif %}
    <span class="toggle" role="group" aria-label="Detail level">
      <button type="button" id="mode-normal" class="on" aria-pressed="true">Normal</button><button
              type="button" id="mode-advanced" aria-pressed="false">Advanced</button>
    </span>
  </div>

  {% if sample_mode %}
  <div class="notice">
    <h2>Demonstration data</h2>
    <p>Aircraft airborne near {{ airport.iata }}, not a published schedule. Times are "now",
    an overflight cannot be told from an arrival, and the list is not filtered by direction.</p>
  </div>
  {% endif %}

  {% if notams and notams.significant %}
  <div class="notice">
    <h2>Aerodrome NOTAMs</h2>
    {% for line in notams.summary() %}<p>{{ line }}</p>{% endfor %}
  </div>
  {% endif %}

  <div class="board-wrap">
    <table class="board">
      <thead><tr>
        <th>Time</th><th>Flight</th>
        <th>{{ "From" if direction == "arrival" else "To" }}</th>
        <th>Aircraft</th><th>Conditions</th><th class="adv-cell">Rwy</th><th class="adv-cell">Xwind</th>
        <th>Status</th><th>Outlook</th><th>Detail</th>
      </tr></thead>
      <tbody>
      {% for a in assessments %}
        <tr>
          <td class="time" data-l="Time">{{ a.flight.scheduled.astimezone(tz).strftime('%H:%M') }}</td>
          <td class="flt" data-l="Flight">{{ a.flight.callsign or a.flight.number }}</td>
          <td class="port" data-l="{{ "From" if direction == "arrival" else "To" }}">{{ a.flight.other_label }}</td>
          <td class="ac" data-l="Aircraft">{{ a.profile.name }}</td>
          <td data-l="Conditions"><span class="normal-only">{{ a.plain_category }}</span><span class="adv-only">{{ a.category }}</span></td>
          <td class="adv-cell" data-l="Runway">{{ a.runway or "—" }}</td>
          <td class="adv-cell" data-l="Crosswind">{{ a.crosswind | num }} kt</td>
          <td data-l="Status"><span class="chip c-{{ a.colour }}">{{ {"green":"Clear","yellow":"Monitor","orange":"At risk"}[a.colour] }}</span></td>
          <td class="outlook" data-l="Outlook"><span class="normal-only">{{ a.plain_outlook }}</span><span class="adv-only">{{ a.outlook }}</span></td>
          <td class="why" data-l="Detail"><span class="normal-only">{{ a.reason }}</span><span class="adv-only">{{ a.reason_technical or a.reason }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="legend">
    <span class="chip c-green">Clear</span> weather unlikely to affect the schedule
    <span class="chip c-yellow">Monitor</span> could plausibly delay
    <span class="chip c-orange">At risk</span> likely to delay, de-ice, hold or divert
  </div>

  <div class="panel">
    <h2>Terminal aerodrome forecast — {{ airport.icao }}</h2>
    <pre>{{ raw_taf }}</pre>
  </div>

  <footer>
    <div>Assessments {% if assessed_by == "claude" %}written by Claude and checked against the source figures{% else %}generated by rule{% endif %}. TAF and METAR from the NOAA Aviation Weather Center. NOTAMs from NAV CANADA. Runway data from OurAirports.</div>
    <div style="margin-top:.5rem"><strong>Not an operational product.</strong> This estimates schedule risk only. It is not a statement about whether any flight is safe or legal to operate — crews and operators decide that against their own limits and current official data.</div>
  </footer>
</div>

<script>
  (function () {
    var board = document.querySelector('.fids');
    var normal = document.getElementById('mode-normal');
    var advanced = document.getElementById('mode-advanced');
    if (!board || !normal || !advanced) return;

    function apply(mode) {
      var adv = mode === 'advanced';
      board.classList.toggle('adv', adv);
      advanced.classList.toggle('on', adv);
      normal.classList.toggle('on', !adv);
      advanced.setAttribute('aria-pressed', String(adv));
      normal.setAttribute('aria-pressed', String(!adv));
      try { localStorage.setItem('sheerr-fids-mode', mode); } catch (e) {}
    }

    normal.addEventListener('click', function () { apply('normal'); });
    advanced.addEventListener('click', function () { apply('advanced'); });

    var saved = null;
    try { saved = localStorage.getItem('sheerr-fids-mode'); } catch (e) {}
    if (saved === 'advanced') apply('advanced');
  })();
</script>
{% endblock %}
