# The Weather Company (weather.com) API key.
# Required only when using the `twc` provider. Open-Meteo needs no key.
TWC_API_KEY=your-twc-api-key-here

# Open-Meteo commercial API key. The free endpoint is non-commercial use
# only; set this for business use and requests switch to customer-api.
OPENMETEO_API_KEY=
